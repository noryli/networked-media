<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= flower.title %> - Secret Garden</title>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.4.0/p5.js"></script>
  <link rel="stylesheet" href="/css/view.css">
  <script src="/js/view.js" defer></script>
</head>
<body>

  <!-- flower data for p5.js to use -->
  <div id="flower-data"
       data-petal-color="<%= flower.petalColor %>"
       data-center-color="<%= flower.centerColor %>"
       data-petal-count="<%= flower.petalCount %>"
       data-shape="<%= flower.shape %>">
  </div>

  <!-- back button -->
  <div id="header">
    <svg onclick="window.location.href = '/garden'" viewBox="0 0 1024 1024" width="40" height="40" xmlns="http://www.w3.org/2000/svg">
      <path d="M5.12 504.32c2.048-13.312 8.704-26.112 18.944-34.816l390.144-390.144c23.552-19.968 58.88-17.408 79.36 6.144 17.92 20.992 17.92 52.224 0 73.216L196.096 456.192h763.904c31.232 0 56.32 25.088 56.32 56.32s-25.088 56.32-56.32 56.32H196.096l297.472 297.472c22.016 22.016 22.016 57.344 0.512 79.36-22.016 22.016-57.344 22.016-79.36 0.512L20.48 552.448c-12.288-12.8-17.92-30.72-15.36-48.128z"/>
    </svg>
  </div>

  <!-- left: p5 canvas -->
  <div id="sketch-holder"></div>

  <!-- right: info panel -->
  <div id="info-panel">
    <h1><%= flower.title %></h1>
    <p><strong>Description:</strong> <%= flower.description %></p>

    <% if (flower.imagePath) { %>
      <img src="<%= flower.imagePath %>" class="flower-image" alt="Uploaded Image">
    <% } %>

    <div class="action-buttons">
      <a href="/edit?id=<%= flower._id %>" class="edit-button">Edit This Flower</a>
      <form method="POST" action="/deleteFlower" onsubmit="return confirm('Are you sure you want to delete this flower?');">
        <input type="hidden" name="id" value="<%= flower._id %>">
        <button type="submit" class="delete-button">Delete</button>
      </form>
    </div>
  </div>

</body>
</html>
